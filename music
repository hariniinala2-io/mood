        // --- STREAMING_CHUNK:JavaScript Logic - Authentication ---

        function initAuthTabs() {
            const tabLogin = document.getElementById('tab-login');
            const tabSignup = document.getElementById('tab-signup');
            const formLogin = document.getElementById('form-login');
            const formSignup = document.getElementById('form-signup');
            const loginBtn = formLogin.querySelector('button[type="submit"]');
            const signupBtn = formSignup.querySelector('button[type="submit"]');

            tabLogin.addEventListener('click', () => {
                formLogin.classList.remove('hidden');
                formSignup.classList.add('hidden');
                tabLogin.className = "flex-1 text-lg font-semibold text-brand-400 border-b-2 border-brand-500 pb-2 transition-colors";
                tabSignup.className = "flex-1 text-lg font-semibold text-gray-500 hover:text-gray-300 pb-2 transition-colors border-b-2 border-transparent";
            });

            tabSignup.addEventListener('click', () => {
                formSignup.classList.remove('hidden');
                formLogin.classList.add('hidden');
                tabSignup.className = "flex-1 text-lg font-semibold text-pink-400 border-b-2 border-pink-500 pb-2 transition-colors";
                tabLogin.className = "flex-1 text-lg font-semibold text-gray-500 hover:text-gray-300 pb-2 transition-colors border-b-2 border-transparent";
            });

            formSignup.addEventListener('submit', (e) => {
                e.preventDefault();
                const user = document.getElementById('signup-user').value.trim();
                const pass = document.getElementById('signup-pass').value.trim();
                
                // Show loading state
                signupBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Creating...';
                signupBtn.disabled = true;

                // Fake a small network delay so the animation shows
                setTimeout(() => {
                    const existingUsers = JSON.parse(localStorage.getItem('vibe_users')) || {};
                    
                    if (existingUsers[user]) {
                        showToast('Username already exists. Please login.', 'error');
                    } else {
                        // Save account locally
                        existingUsers[user] = pass;
                        localStorage.setItem('vibe_users', JSON.stringify(existingUsers));
                        
                        showToast('Account created! Logging in...');
                        loginUser(user);
                    }
                    
                    // Reset button state
                    signupBtn.innerHTML = 'Create Account <i class="fas fa-user-check ml-2"></i>';
                    signupBtn.disabled = false;
                }, 800);
            });

            formLogin.addEventListener('submit', (e) => {
                e.preventDefault();
                const user = document.getElementById('login-user').value.trim();
                const pass = document.getElementById('login-pass').value.trim();

                // Show loading state
                loginBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Loading...';
                loginBtn.disabled = true;

                // Fake a small network delay
                setTimeout(() => {
                    const existingUsers = JSON.parse(localStorage.getItem('vibe_users')) || {};

                    if (existingUsers[user] && existingUsers[user] === pass) {
                        showToast(`Welcome back, ${user}!`);
                        loginUser(user);
                    } else {
                        showToast('Invalid username or password.', 'error');
                    }
                    
                    // Reset button state
                    loginBtn.innerHTML = 'Let\'s Vibe <i class="fas fa-arrow-right ml-2"></i>';
                    loginBtn.disabled = false;
                }, 800);
            });
        }

