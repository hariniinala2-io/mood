                </div>
            `).join('');

            // Row 1 uses first half of random, Row 2 uses second half (shuffled nicely)
            const shuffled = [...doubleArtists].sort(() => 0.5 - Math.random());
            row1.innerHTML = createCards(shuffled);
            row2.innerHTML = createCards([...shuffled].reverse());
