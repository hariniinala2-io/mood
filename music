        async function fetchSongPreview(title, artist, lang) {
            try {
                // Attempt 1: Exact Title + Artist
                let query = encodeURIComponent(`${title} ${artist}`);
                let res = await fetch(`https://itunes.apple.com/search?term=${query}&limit=1&media=music`);
                let data = await res.json();
                
                // Attempt 2: Title + Language (fallback for regional songs)
                if (!data.results || data.results.length === 0) {
                    query = encodeURIComponent(`${title} ${lang}`);
                    res = await fetch(`https://itunes.apple.com/search?term=${query}&limit=1&media=music`);
                    data = await res.json();
                }

                // Attempt 3: Just Title
                if (!data.results || data.results.length === 0) {
                    query = encodeURIComponent(`${title}`);
                    res = await fetch(`https://itunes.apple.com/search?term=${query}&limit=1&media=music`);
                    data = await res.json();
                }

                if (data.results && data.results.length > 0) {
                    return {
                        url: data.results[0].previewUrl,
                        cover: data.results[0].artworkUrl100
                    };
                }
            } catch (e) {
                console.error("iTunes search failed", e);
            }
            // Better ambient fallback audio if absolutely nothing is found (Rain/Wave sounds)
            return {
                url: "https://actions.google.com/sounds/v1/water/waves_crashing_on_rock_beach.ogg",
                cover: null
            };
        }

        async function playSong(index) {
            if (index < 0 || index >= currentPlaylist.length) return;
            
            currentSongIndex = index;
            const song = currentPlaylist[index];
            
            // Slide up the player UI
            document.getElementById('player-bar').classList.remove('translate-y-full');
            document.getElementById('player-title').textContent = song.title;
            document.getElementById('player-artist').textContent = song.artist;
            
            // Highlight the playing row
            document.querySelectorAll('.song-row').forEach(el => el.classList.remove('bg-brand-500/20', 'border-l-4', 'border-brand-500'));
            const activeRow = document.getElementById(`song-row-${index}`);
            if(activeRow) activeRow.classList.add('bg-brand-500/20', 'border-l-4', 'border-brand-500');

            // Show loading spinner
            const playBtn = document.getElementById('play-pause-btn');
            playBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

            // Fetch actual audio preview dynamically from iTunes
            if (!song.audioUrl) {
                const mediaData = await fetchSongPreview(song.title, song.artist, state.currentLang);
                song.audioUrl = mediaData.url;
                if(mediaData.cover && !song.customCover) {
                    song.customCover = mediaData.cover;
                }
            }

            // Update UI with real album cover if found
            const coverImg = song.customCover || `https://source.unsplash.com/random/100x100/?abstract,${state.currentMood?.name?.toLowerCase()}&sig=${index}`;
            document.getElementById('player-cover').src = coverImg;
            
            // Update row cover image too
            if (activeRow) {
                const rowImg = activeRow.querySelector('.song-cover-img');
                if (rowImg && song.customCover) rowImg.src = song.customCover;
            }

            // Play the audio
            audioEl.src = song.audioUrl;
            audioEl.play().then(() => {
                isPlaying = true;
                playBtn.innerHTML = '<i class="fas fa-pause"></i>';
            }).catch(e => {
                showToast("Please click play to start audio.", "error");
                playBtn.innerHTML = '<i class="fas fa-play ml-1"></i>';
                isPlaying = false;
            });
        }

        function togglePlay() {
            if (!audioEl.src) return;
            const playBtn = document.getElementById('play-pause-btn');
            
            if (isPlaying) {
                audioEl.pause();
                isPlaying = false;
                playBtn.innerHTML = '<i class="fas fa-play ml-1"></i>';
            } else {
                audioEl.play();
                isPlaying = true;
                playBtn.innerHTML = '<i class="fas fa-pause"></i>';
            }
        }

        function nextSong() {
            playSong((currentSongIndex + 1) % currentPlaylist.length);
        }

        function prevSong() {
            playSong((currentSongIndex - 1 + currentPlaylist.length) % currentPlaylist.length);
        }

        function seekAudio(event) {
            const container = document.getElementById('progress-container');
            const rect = container.getBoundingClientRect();
            const clickX = event.clientX - rect.left;
            const width = rect.width;
            const percentage = clickX / width;
            if (audioEl.duration) {
                audioEl.currentTime = percentage * audioEl.duration;
            }
        }

        function setVolume(val) {
            audioEl.volume = val;
        }

        // Audio Event Listeners for Progress Bar
        audioEl.addEventListener('timeupdate', () => {
            const current = audioEl.currentTime;
            const total = audioEl.duration || 30;
            
            document.getElementById('progress-bar').style.width = `${(current / total) * 100}%`;
            
            const formatTime = (time) => {
                if (isNaN(time)) return "0:00";
                const mins = Math.floor(time / 60);
                const secs = Math.floor(time % 60);
                return `${mins}:${secs.toString().padStart(2, '0')}`;
            };
            
            document.getElementById('time-current').textContent = formatTime(current);
           document.getElementById('time-total').textContent = formatTime(total);
        });

        audioEl.addEventListener('ended', nextSong);

        // --- STREAMING_CHUNK:JavaScript Logic - Initialization ---
        
        // Expose functions to window so inline HTML triggers can find them (since script is now type="module")
        window.logout = logout;
        window.selectLanguage = selectLanguage;
        window.goBackToLanguage = goBackToLanguage;
        window.goBackToMood = goBackToMood;
        window.selectMood = selectMood;
        window.playSong = playSong;
        window.togglePlay = togglePlay;
        window.nextSong = nextSong;
        window.prevSong = prevSong;
        window.seekAudio = seekAudio;
        window.setVolume = setVolume;

        window.onload = async () => {
            initBackground();
            await initFirebase();
            initAuthTabs();
        };

    </script>
</body>
</html>