        function initBackground() {
            const row1 = document.getElementById('artist-row-1');
            const row2 = document.getElementById('artist-row-2');
            
            // Double the array for seamless infinite marquee
            const doubleArtists = [...artists, ...artists];
            
            // Generate HTML for cards
            const createCards = (items) => items.map(artist => `
                <div class="artist-card flex-shrink-0 w-32 h-32 sm:w-48 sm:h-48 rounded-xl shadow-lg border border-white/5">
                    <img src="${artist.img}" alt="${artist.name}" class="w-full h-full object-cover">
