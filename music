                <button onclick="selectLanguage('Telugu')" class="group relative overflow-hidden rounded-2xl aspect-[4/3] shadow-lg transform transition hover:-translate-y-2 hover:shadow-brand-500/20 text-left">
                    <img src="https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=600&q=80" alt="Telugu" class="absolute inset-0 w-full h-full object-cover transition duration-500 group-hover:scale-110 opacity-60">
                    <div class="absolute inset-0 bg-gradient-to-t from-dark-950 via-dark-950/40 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 p-6">
                        <h3 class="text-3xl font-display font-bold text-white mb-1">Telugu</h3>
                        <p class="text-brand-300 group-hover:text-brand-200 transition">Tollywood Hits <i class="fas fa-chevron-right ml-1 opacity-0 group-hover:opacity-100 transition"></i></p>
                    </div>
                </button>
                
                <button onclick="selectLanguage('Hindi')" class="group relative overflow-hidden rounded-2xl aspect-[4/3] shadow-lg transform transition hover:-translate-y-2 hover:shadow-pink-500/20 text-left">
                    <img src="https://images.unsplash.com/photo-1459749411175-04bf5292ceea?w=600&q=80" alt="Hindi" class="absolute inset-0 w-full h-full object-cover transition duration-500 group-hover:scale-110 opacity-60">
                    <div class="absolute inset-0 bg-gradient-to-t from-dark-950 via-dark-950/40 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 p-6">
                        <h3 class="text-3xl font-display font-bold text-white mb-1">Hindi</h3>
                        <p class="text-pink-300 group-hover:text-pink-200 transition">Bollywood Chartbusters <i class="fas fa-chevron-right ml-1 opacity-0 group-hover:opacity-100 transition"></i></p>
                    </div>
                </button>

                <button onclick="selectLanguage('English')" class="group relative overflow-hidden rounded-2xl aspect-[4/3] shadow-lg transform transition hover:-translate-y-2 hover:shadow-blue-500/20 text-left">
                    <img src="https://images.unsplash.com/photo-1470225620780-dba8ba36b745?w=600&q=80" alt="English" class="absolute inset-0 w-full h-full object-cover transition duration-500 group-hover:scale-110 opacity-60">
                    <div class="absolute inset-0 bg-gradient-to-t from-dark-950 via-dark-950/40 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 p-6">
                        <h3 class="text-3xl font-display font-bold text-white mb-1">English</h3>
                        <p class="text-blue-300 group-hover:text-blue-200 transition">Global Top 50 <i class="fas fa-chevron-right ml-1 opacity-0 group-hover:opacity-100 transition"></i></p>
                    </div>
                </button>

                <button onclick="selectLanguage('Tamil')" class="group relative overflow-hidden rounded-2xl aspect-[4/3] shadow-lg transform transition hover:-translate-y-2 hover:shadow-yellow-500/20 text-left">
                    <img src="https://images.unsplash.com/photo-1501612780327-45045538702b?w=600&q=80" alt="Tamil" class="absolute inset-0 w-full h-full object-cover transition duration-500 group-hover:scale-110 opacity-60">
                    <div class="absolute inset-0 bg-gradient-to-t from-dark-950 via-dark-950/40 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 p-6">
                        <h3 class="text-3xl font-display font-bold text-white mb-1">Tamil</h3>
                        <p class="text-yellow-300 group-hover:text-yellow-200 transition">Kollywood Beats <i class="fas fa-chevron-right ml-1 opacity-0 group-hover:opacity-100 transition"></i></p>
                    </div>
                </button>
            </div>
        </div>

        <!-- View 3: Mood Selection -->
        <div id="view-mood" class="hidden w-full max-w-5xl animate-fade-in">
            <div class="flex items-center mb-8 gap-4">
                <button onclick="goBackToLanguage()" class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition"><i class="fas fa-arrow-left"></i></button>
                <div>
                    <h2 class="text-3xl sm:text-4xl font-display font-bold text-white">How are you feeling?</h2>
                    <p class="text-gray-400 text-lg">Select a mood for your <span id="display-lang" class="text-brand-400 font-semibold">Language</span> playlist.</p>
                </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
                <!-- Mood Cards generated by JS -->
                <div id="mood-grid" class="col-span-full grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4"></div>
            </div>
        </div>

        <!-- View 4: Playlist View -->
        <div id="view-playlist" class="hidden w-full max-w-4xl animate-fade-in">
            <div class="glass-panel rounded-2xl overflow-hidden shadow-2xl flex flex-col md:flex-row">
                
                <!-- Left Sidebar: Playlist Info -->
                <div class="w-full md:w-1/3 p-8 bg-gradient-to-br from-dark-800 to-dark-900 border-r border-white/5 flex flex-col items-center md:items-start text-center md:text-left">
                    <button onclick="goBackToMood()" class="mb-6 text-gray-400 hover:text-white transition flex items-center"><i class="fas fa-arrow-left mr-2"></i> Back</button>
                    
                    <div class="w-48 h-48 rounded-xl shadow-2xl mb-6 relative overflow-hidden group">
                        <img id="playlist-cover" src="https://images.unsplash.com/photo-1614613535308-eb5fbd3d2c17?w=400&q=80" alt="Cover" class="w-full h-full object-cover transition duration-500 group-hover:scale-110">
                        <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition">
                            <i class="fas fa-play-circle text-5xl text-white drop-shadow-lg"></i>
                        </div>
                    </div>
                    
                    <h2 id="playlist-title" class="text-3xl font-display font-bold text-white mb-2 leading-tight">Mood Playlist</h2>
                    <p class="text-brand-400 font-medium mb-4"><i class="fab fa-spotify mr-1"></i> JioSaavn Curated</p>
                    <p id="playlist-desc" class="text-gray-400 text-sm mb-6">Top trendy tracks perfectly matched for your current vibe and language.</p>
                    
                    <button id="play-all-btn" onclick="playSong(0)" class="w-full bg-brand-600 hover:bg-brand-500 text-white font-bold py-3 px-4 rounded-full shadow-lg transition flex items-center justify-center gap-2">
                        <i class="fas fa-play"></i> Play All
                    </button>
                </div>

                <!-- Right Side: Song List -->
                <div class="w-full md:w-2/3 p-2 sm:p-6 bg-dark-900/80">
                    <div class="flex text-xs font-semibold text-gray-400 uppercase tracking-wider pb-3 border-b border-gray-800 mb-4 px-4">
                        <div class="w-8 text-center">#</div>
                        <div class="flex-grow">Title</div>
                        <div class="w-16 text-right"><i class="far fa-clock"></i></div>
                    </div> <!-- Added missing closing tag here -->
                    <div id="song-list" class="space-y-1 max-h-[60vh] overflow-y-auto pr-2 pb-4">
                        <!-- Songs injected here -->
                    </div>
                </div>
            </div>
        </div>

    </main>

    <!-- Audio Player Bar -->
    <div id="player-bar" class="fixed bottom-0 left-0 right-0 bg-dark-950/95 backdrop-blur-xl border-t border-gray-800 p-3 sm:p-4 transform translate-y-full transition-transform duration-500 z-40 flex items-center gap-4">
        <audio id="main-audio"></audio>
        
        <!-- Now Playing Info -->
        <div class="flex items-center gap-3 w-1/3 min-w-0">
            <div class="w-12 h-12 rounded bg-dark-800 overflow-hidden flex-shrink-0 relative group">
                <img id="player-cover" src="https://placehold.co/100x100/1e1b4b/8b5cf6?text=V" class="w-full h-full object-cover">
            </div>
            <div class="min-w-0">
                <div id="player-title" class="text-white font-semibold text-sm truncate">Select a song</div>
                <div id="player-artist" class="text-gray-400 text-xs truncate">Artist</div>
            </div>
        </div>

        <!-- Controls -->
        <div class="flex flex-col items-center justify-center flex-1 max-w-md">
            <div class="flex items-center gap-6 mb-2">
                <button onclick="prevSong()" class="text-gray-400 hover:text-white transition"><i class="fas fa-step-backward"></i></button>
                <button onclick="togglePlay()" id="play-pause-btn" class="w-10 h-10 rounded-full bg-brand-600 hover:bg-brand-500 text-white flex items-center justify-center transition transform hover:scale-105">
                    <i class="fas fa-play ml-1"></i>
                </button>
                <button onclick="nextSong()" class="text-gray-400 hover:text-white transition"><i class="fas fa-step-forward"></i></button>
            </div>
            <!-- Progress Bar -->
            <div class="w-full flex items-center gap-2 text-xs text-gray-500 font-medium">
                <span id="time-current">0:00</span>
                <div class="flex-1 h-1.5 bg-gray-800 rounded-full overflow-hidden cursor-pointer relative" id="progress-container" onclick="seekAudio(event)">
                    <div id="progress-bar" class="h-full bg-brand-500 w-0 pointer-events-none transition-all duration-100 ease-linear"></div>
                </div>
                <span id="time-total">0:30</span>
            </div>
        </div>

        <!-- Volume/Extras -->
        <div class="w-1/3 hidden sm:flex justify-end items-center gap-3 text-gray-400">
            <i class="fas fa-volume-up text-sm"></i>
            <input type="range" id="volume-slider" min="0" max="1" step="0.01" value="1" class="w-24 h-1 bg-gray-800 rounded-lg appearance-none cursor-pointer" onchange="setVolume(this.value)">
        </div>
    </div>

    <!-- Global Toast Container -->
    <div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, getDoc, setDoc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // --- FIREBASE CONFIGURATION ---
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'vibestream-default';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : null;
        
        let db;
        let auth;
        let isFirebaseReady = false;

        if (firebaseConfig) {
            const app = initializeApp(firebaseConfig);
            db = getFirestore(app);
            auth = getAuth(app);
        }

        async function initFirebase() {
            if (!auth) return;
            try {
                if (typeof __initial_auth_token !== 'undefined') {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }
                isFirebaseReady = true;
            } catch (e) {
                console.error("Firebase Auth Error", e);
                showToast("Database connection failed", "error");
            }
        }

        // --- DATA CONFIGURATION ---

        const artists = [
            { name: "Anirudh", img: "https://images.unsplash.com/photo-1516280440502-6c24099b24b8?w=300&h=300&fit=crop" },
            { name: "S S Thaman", img: "https://images.unsplash.com/photo-1493225457124-a1a2a5f5f928?w=300&h=300&fit=crop" },
            { name: "DSP", img: "https://images.unsplash.com/photo-1598387181032-a3103a2db5b3?w=300&h=300&fit=crop" },
            { name: "The Weeknd", img: "https://images.unsplash.com/photo-1618349581373-d56b001d2d3e?w=300&h=300&fit=crop" },
            { name: "Taylor Swift", img: "https://images.unsplash.com/photo-1498038432885-c6f3f1b912ee?w=300&h=300&fit=crop" },
            { name: "Sai Abhyankar", img: "https://images.unsplash.com/photo-1520523839897-bd0b52f945a0?w=300&h=300&fit=crop" },
            { name: "Sabrina Carpenter", img: "https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?w=300&h=300&fit=crop" },
            { name: "Arijit Singh", img: "https://images.unsplash.com/photo-1506157786151-b8491531f063?w=300&h=300&fit=crop" },
            { name: "Shreya Ghoshal", img: "https://images.unsplash.com/photo-1525362081669-2b476bb628c3?w=300&h=300&fit=crop" },
            { name: "Jonita Gandhi", img: "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=300&h=300&fit=crop" }
        ];

        const moods = [
            { id: "happy", name: "Happy", icon: "fa-smile-beam", color: "from-yellow-400 to-orange-500" },
            { id: "sad", name: "Sad", icon: "fa-sad-tear", color: "from-blue-600 to-blue-800" },
            { id: "rage", name: "Rage", icon: "fa-fire", color: "from-red-600 to-red-900" },
            { id: "romantic", name: "Romantic", icon: "fa-wine-glass", color: "from-purple-500 to-pink-500" }
        ];

        // --- APP STATE ---
        const state = {
            currentUser: null,
            usersDb: {}, // In-memory mock database { username: password }
            currentLang: null,
            currentMood: null
        };

        let currentPlaylist = [];
        let currentSongIndex = -1;
        let isPlaying = false;
        const audioEl = new Audio();

        // --- STREAMING_CHUNK:JavaScript Logic - UI Utilities ---
        
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            const colors = type === 'error' ? 'bg-red-500/90 border-red-400' : 'bg-brand-600/90 border-brand-400';
            const icon = type === 'error' ? 'fa-exclamation-circle' : 'fa-check-circle';
            
            toast.className = `glass-panel ${colors} text-white px-6 py-3 rounded-xl shadow-2xl flex items-center gap-3 border toast-enter`;
            toast.innerHTML = `<i class="fas ${icon}"></i> <span class="font-medium">${message}</span>`;
            
            container.appendChild(toast);
            
            // Trigger animation frame for transition
            requestAnimationFrame(() => {
                toast.classList.remove('toast-enter');
                toast.classList.add('toast-enter-active');
            });

            setTimeout(() => {
                toast.classList.remove('toast-enter-active');
                toast.classList.add('toast-exit-active');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        function switchView(viewId) {
            const views = ['view-auth', 'view-language', 'view-mood', 'view-playlist'];
            views.forEach(v => {
                const el = document.getElementById(v);
                if (v === viewId) {
                    el.classList.remove('hidden');
